{
  "name": "spawn-ui-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs:dev": "npm run dev -w @spawn-ui/docs",
    "docs:build": "npm run build -w @spawn-ui/docs"
  }
}
